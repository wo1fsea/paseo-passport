+import { describe, expect, it, vi } from "vitest";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import {
+  fetchPassportDispatchDashboardAvailability,
+  type PassportDispatchDashboardAvailability,
+} from "@/runtime/passport-dispatch-dashboard";
+
+const splitContainerSourcePath = fileURLToPath(
+  new URL("../../components/split-container.tsx", import.meta.url),
+);
+const workspaceScreenSourcePath = fileURLToPath(new URL("./workspace-screen.tsx", import.meta.url));
+
+describe("Passport Dispatch Dashboard availability client", () => {
+  it("queries the same-origin current-dashboard endpoint with an encoded cwd", async () => {
+    const payload: PassportDispatchDashboardAvailability = {
+      available: true,
+      runId: "20260506T081555540696Z",
+      url: "/dispatch-dashboard/20260506T081555540696Z/",
+      label: "Dispatch Dashboard",
+    };
+    const fetchImpl = vi.fn(async () => ({
+      ok: true,
+      json: async () => payload,
+    })) as unknown as typeof fetch;
+
+    await expect(
+      fetchPassportDispatchDashboardAvailability({
+        cwd: "/Users/example/Project With Spaces",
+        fetchImpl,
+      }),
+    ).resolves.toEqual(payload);
+
+    expect(fetchImpl).toHaveBeenCalledWith(
+      "/api/dispatch/dashboard/current?cwd=%2FUsers%2Fexample%2FProject%20With%20Spaces",
+      { credentials: "include" },
+    );
+  });
+
+  it("fails closed when the availability request fails", async () => {
+    const fetchImpl = vi.fn(async () => ({
+      ok: false,
+      json: async () => ({ available: true, url: "http://127.0.0.1:9876" }),
+    })) as unknown as typeof fetch;
+
+    await expect(
+      fetchPassportDispatchDashboardAvailability({
+        cwd: "/Users/example/Project",
+        fetchImpl,
+      }),
+    ).resolves.toEqual({ available: false });
+  });
+});
+
+describe("SplitContainer Dispatch Dashboard tab-row contract", () => {
+  it("forwards dashboard action props into split-pane desktop tab rows", () => {
+    const source = readFileSync(splitContainerSourcePath, "utf8");
+    const splitPaneTabRowRender = source.match(
+      /<WorkspaceDesktopTabsRow[\s\S]*?tabDropPreviewIndex=\{[\s\S]*?\}\s*\/>/,
+    )?.[0];
+
+    expect(splitPaneTabRowRender).toContain("dispatchDashboardAction={dispatchDashboardAction}");
+    expect(splitPaneTabRowRender).toContain(
+      "onOpenDispatchDashboard={onOpenDispatchDashboard}",
+    );
+  });
+
+  it("receives dashboard action props from the workspace screen", () => {
+    const source = readFileSync(workspaceScreenSourcePath, "utf8");
+    const splitContainerRender = source.match(
+      /<SplitContainer[\s\S]*?renderPaneEmptyState=\{renderSplitPaneEmptyState\}\s*\/>/,
+    )?.[0];
+
+    expect(splitContainerRender).toContain("dispatchDashboardAction={dispatchDashboardAction}");
+    expect(splitContainerRender).toContain(
+      "onOpenDispatchDashboard={handleOpenDispatchDashboard}",
+    );
+  });
+});

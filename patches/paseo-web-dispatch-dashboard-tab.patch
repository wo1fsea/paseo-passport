@@ -0,0 +1,75 @@
+export type PassportDispatchDashboardAvailability =
+  | {
+      available: true;
+      runId: string;
+      url: string;
+      label: string;
+    }
+  | {
+      available: false;
+      reason?: string;
+    };
+
+interface FetchPassportDispatchDashboardAvailabilityInput {
+  cwd: string | null | undefined;
+  fetchImpl?: typeof fetch;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null;
+}
+
+function isSafeSameOriginDashboardUrl(value: unknown): value is string {
+  return (
+    typeof value === "string" &&
+    value.startsWith("/dispatch-dashboard/") &&
+    !value.startsWith("//") &&
+    !value.includes("://")
+  );
+}
+
+function normalizeDashboardAvailability(
+  payload: unknown,
+): PassportDispatchDashboardAvailability {
+  if (!isRecord(payload) || payload.available !== true) {
+    return { available: false };
+  }
+
+  if (
+    typeof payload.runId !== "string" ||
+    !isSafeSameOriginDashboardUrl(payload.url) ||
+    typeof payload.label !== "string"
+  ) {
+    return { available: false };
+  }
+
+  return {
+    available: true,
+    runId: payload.runId,
+    url: payload.url,
+    label: payload.label,
+  };
+}
+
+export async function fetchPassportDispatchDashboardAvailability({
+  cwd,
+  fetchImpl = globalThis.fetch,
+}: FetchPassportDispatchDashboardAvailabilityInput): Promise<PassportDispatchDashboardAvailability> {
+  const trimmedCwd = typeof cwd === "string" ? cwd.trim() : "";
+  if (!trimmedCwd || typeof fetchImpl !== "function") {
+    return { available: false };
+  }
+
+  try {
+    const response = await fetchImpl(
+      `/api/dispatch/dashboard/current?cwd=${encodeURIComponent(trimmedCwd)}`,
+      { credentials: "include" },
+    );
+    if (!response.ok) {
+      return { available: false };
+    }
+    return normalizeDashboardAvailability(await response.json());
+  } catch {
+    return { available: false };
+  }
+}
